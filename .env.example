# BustOutSentry Configuration

# FastAPI Backend Server
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_URL=http://localhost:8000

# Kafka Broker Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS=transactions
KAFKA_CONSUMER_GROUP=bustoutsentry-ml

# Machine Learning Paths (Optional override; defaults to ml/artifacts)
# ML_MODEL_PATH=ml/artifacts/temporal_xgboost.pkl
# ML_FEATURE_NAMES_PATH=ml/artifacts/temporal_feature_names.pkl
